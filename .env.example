# Public, non-secret config only. Everything prefixed VITE_ is bundled into the browser.
# Never put tokens, API keys, or passwords here.

# Base URL for the API. Leave as /api to use the mock API in development.
# Leave unset to use the mock API inside the app's folder (/api locally, /bug-bazaar/api
# on GitHub Pages). Set it only to point at a real backend, e.g. https://api.example.com/api
# VITE_API_BASE_URL=

# "false" turns the MSW mock API off when a real backend exists.
VITE_API_MOCK=true
